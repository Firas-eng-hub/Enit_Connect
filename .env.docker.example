# ============================================
# TIC-Connect Docker Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ===================
# Server Configuration
# ===================
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000
APP_URL=http://localhost

# ===================
# JWT Authentication
# ===================
# REQUIRED. The backend refuses to start if this is missing, shorter than
# 32 characters, or a placeholder. Generate with: openssl rand -base64 48
JWT_SECRET=

# ===================
# PostgreSQL Configuration
# ===================
# REQUIRED. docker compose refuses to start without POSTGRES_PASSWORD.
# Use the SAME strong password in both lines. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Use the docker service name (db) inside containers
DATABASE_URL=postgresql://enit_user:<POSTGRES_PASSWORD>@db:5432/enit_connect

# ===================
# Gmail SMTP Configuration
# ===================
# 1. Enable 2-Factor Authentication on your Gmail
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password here
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
MAIL_NOTIFICATIONS_ENABLED=true
MAIL_IMMEDIATE_ADMIN_NOTICE=true

# ===================
# Optional: Geocoder (Geoapify, falls back to OpenStreetMap when empty)
# ===================
GEOAPIFY_API_KEY=

# ===================
# Optional: proxy trust (default: only private-network proxies such as nginx)
# ===================
# TRUST_PROXY=
